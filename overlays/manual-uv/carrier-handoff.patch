+static int m3q_gpu_uv_wait_signal(const sigset_t *set, int timeout_sec) {
+  struct timespec timeout = {.tv_sec = timeout_sec, .tv_nsec = 0};
+  for (;;) {
+    errno = 0;
+    int sig = sigtimedwait(set, NULL, &timeout);
+    if (sig >= 0 || errno != EINTR) {
+      return sig;
+    }
+  }
+}
+
+static int m3q_gpu_uv_read_request(uintptr_t *adreno) {
+  char text[64];
+  int fd = open(M3Q_GPU_UV_REQUEST_PATH, O_RDONLY | O_CLOEXEC);
+  if (fd < 0) {
+    return 0;
+  }
+
+  ssize_t got = read(fd, text, sizeof(text) - 1);
+  close(fd);
+  unlink(M3Q_GPU_UV_REQUEST_PATH);
+  if (got <= 0 || got >= (ssize_t)sizeof(text)) {
+    return 0;
+  }
+  text[got] = 0;
+
+  char *end = NULL;
+  errno = 0;
+  unsigned long long parsed = strtoull(text, &end, 0);
+  if (errno || end == text) {
+    return 0;
+  }
+  while (*end == ' ' || *end == '\t' || *end == '\r' || *end == '\n') {
+    end++;
+  }
+  if (*end || !is_kernel_ptr((uintptr_t)parsed)) {
+    return 0;
+  }
+
+  *adreno = (uintptr_t)parsed;
+  return 1;
+}
+
+static int m3q_gpu_uv_addresses(uintptr_t adreno, uintptr_t *gpu_levels,
+                                uintptr_t *gmu_levels, uintptr_t *gx) {
+  if (!is_kernel_ptr(adreno) || adreno < M3Q_ADRENO_TO_GMU_OFF) {
+    return 0;
+  }
+
+  uintptr_t gmu = adreno - M3Q_ADRENO_TO_GMU_OFF;
+  *gpu_levels = gmu + M3Q_GMU_GPU_LEVEL_NUM_OFF;
+  *gmu_levels = gmu + M3Q_GMU_GMU_LEVEL_NUM_OFF;
+  *gx = gmu + M3Q_GMU_GX_VOTES_OFF;
+  return is_kernel_ptr(*gpu_levels) && is_kernel_ptr(*gmu_levels) &&
+         is_kernel_ptr(*gx);
+}
+
+static int m3q_gpu_uv_verify(uintptr_t gx, int patched) {
+  struct m3q_gpu_opp actual[M3Q_GPU_LEVEL_COUNT];
+  struct m3q_gpu_opp expected[M3Q_GPU_LEVEL_COUNT];
+  memcpy(expected, m3q_gpu_stock, sizeof(expected));
+
+  if (patched) {
+    for (size_t i = 2; i < M3Q_GPU_LEVEL_COUNT; i++) {
+      expected[i].vote = m3q_gpu_stock[i - 1].vote;
+      expected[i].dep_vote = m3q_gpu_stock[i - 1].dep_vote;
+    }
+  }
+
+  return m3q_attr_kernel_read_data(gx, actual, sizeof(actual)) &&
+         !memcmp(actual, expected, sizeof(actual));
+}
+
+static int m3q_gpu_uv_restore_stock(uintptr_t gx) {
+  for (size_t i = 2; i < M3Q_GPU_LEVEL_COUNT; i++) {
+    uint32_t pair[2] = {
+        m3q_gpu_stock[i].vote,
+        m3q_gpu_stock[i].dep_vote,
+    };
+    uintptr_t target = gx + i * sizeof(struct m3q_gpu_opp);
+    if (!m3q_attr_kernel_write_data(target, pair, sizeof(pair))) {
+      return 0;
+    }
+  }
+  return m3q_gpu_uv_verify(gx, 0);
+}
+
+/*
+ * Return 1 when the requested 18-state patch is fully verified, 0 when the
+ * request is refused or cleanly rolled back, and -1 when rollback cannot be
+ * proven and a real reboot is required.
+ */
+static int m3q_gpu_uv_apply(uintptr_t adreno, uintptr_t *gx_out) {
+  uintptr_t gpu_levels_addr = 0;
+  uintptr_t gmu_levels_addr = 0;
+  uintptr_t gx = 0;
+  uint32_t gpu_levels = 0;
+  uint32_t gmu_levels = 0;
+
+  if (!m3q_gpu_uv_addresses(adreno, &gpu_levels_addr, &gmu_levels_addr, &gx) ||
+      !m3q_attr_kernel_read_data(gpu_levels_addr, &gpu_levels,
+                                 sizeof(gpu_levels)) ||
+      !m3q_attr_kernel_read_data(gmu_levels_addr, &gmu_levels,
+                                 sizeof(gmu_levels)) ||
+      gpu_levels != M3Q_GPU_LEVEL_COUNT || gmu_levels != M3Q_GMU_LEVEL_COUNT ||
+      !m3q_gpu_uv_verify(gx, 0)) {
+    return 0;
+  }
+
+  for (size_t i = 2; i < M3Q_GPU_LEVEL_COUNT; i++) {
+    uint32_t pair[2] = {
+        m3q_gpu_stock[i - 1].vote,
+        m3q_gpu_stock[i - 1].dep_vote,
+    };
+    uintptr_t target = gx + i * sizeof(struct m3q_gpu_opp);
+    if (!m3q_attr_kernel_write_data(target, pair, sizeof(pair))) {
+      return m3q_gpu_uv_restore_stock(gx) ? 0 : -1;
+    }
+  }
+
+  if (!m3q_gpu_uv_verify(gx, 1)) {
+    return m3q_gpu_uv_restore_stock(gx) ? 0 : -1;
+  }
+
+  *gx_out = gx;
+  return 1;
+}
