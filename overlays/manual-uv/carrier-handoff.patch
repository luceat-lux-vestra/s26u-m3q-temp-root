+static void m3q_gpu_uv_keeper_child(int ready_fd) {
+  sigset_t set;
+  sigemptyset(&set);
+  sigaddset(&set, SIGUSR1);
+  sigaddset(&set, SIGUSR2);
+  sigaddset(&set, SIGTERM);
+  if (sigprocmask(SIG_BLOCK, &set, NULL) != 0) {
+    _exit(120);
+  }
+
+  unlink(M3Q_GPU_UV_REQUEST_PATH);
+  m3q_gpu_uv_set_name("m3q_uv_ready");
+  const uint8_t marker = 1;
+  if (write(ready_fd, &marker, sizeof(marker)) != (ssize_t)sizeof(marker)) {
+    _exit(121);
+  }
+  close(ready_fd);
+
+  /* Do not retain the runner's stdio pipes while the one-shot window is open. */
+  close(STDIN_FILENO);
+  close(STDOUT_FILENO);
+  close(STDERR_FILENO);
+
+  int sig = m3q_gpu_uv_wait_signal(&set, M3Q_GPU_UV_READY_TIMEOUT_SEC);
+  if (sig != SIGUSR1) {
+    _exit(0);
+  }
+
+  uintptr_t adreno = 0;
+  uintptr_t gx = 0;
+  if (!m3q_gpu_uv_read_request(&adreno)) {
+    m3q_gpu_uv_hold_state("m3q_uv_stock");
+    _exit(2);
+  }
+
+  int applied = m3q_gpu_uv_apply(adreno, &gx);
+  if (applied < 0) {
+    m3q_gpu_uv_hold_dirty();
+  }
+  if (!applied) {
+    m3q_gpu_uv_hold_state("m3q_uv_stock");
+    _exit(3);
+  }
+
+  m3q_gpu_uv_set_name("m3q_uv_patched");
+  sig = m3q_gpu_uv_wait_signal(&set, M3Q_GPU_UV_COMMIT_TIMEOUT_SEC);
+
+  if (sig == SIGUSR2 && m3q_gpu_uv_verify(gx, 1)) {
+    m3q_gpu_uv_hold_state("m3q_uv_commit");
+    _exit(0);
+  }
+
+  if (!m3q_gpu_uv_restore_stock(gx)) {
+    m3q_gpu_uv_hold_dirty();
+  }
+  m3q_gpu_uv_hold_state("m3q_uv_stock");
+  _exit(4);
+}
+
+static int m3q_start_gpu_uv_keeper(void) {
+  if (!m3q_attr_carrier_ready || m3q_attr_fd[0] < 0 || m3q_attr_fd[1] < 0) {
+    return 0;
+  }
+
+  int ready[2];
+  if (pipe(ready) != 0) {
+    return 0;
+  }
+
+  pid_t pid = fork();
+  if (pid < 0) {
+    close(ready[0]);
+    close(ready[1]);
+    return 0;
+  }
+  if (pid == 0) {
+    close(ready[0]);
+    m3q_gpu_uv_keeper_child(ready[1]);
+    _exit(127);
+  }
+
+  close(ready[1]);
+  uint8_t marker = 0;
+  ssize_t got;
+  do {
+    got = read(ready[0], &marker, sizeof(marker));
+  } while (got < 0 && errno == EINTR);
+  close(ready[0]);
+  if (got != (ssize_t)sizeof(marker) || marker != 1) {
+    kill(pid, SIGTERM);
+    return 0;
+  }
+
+  pr_success("m3q-gpu-uv-keeper-ready pid=%d timeout=%ds\n", pid,
+             M3Q_GPU_UV_READY_TIMEOUT_SEC);
+  return 1;
+}
 
